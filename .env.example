# Copy to .env.local for `bun dev`. Server-only: never give these a NEXT_PUBLIC_ prefix.
# On Cloudflare, set them as Worker secrets instead (see README → Deploy to Cloudflare).

# The server's default model, as provider/model. Visitors can bring their own key in the header's AI settings.
WEB_AGENTS_MODEL=openai/gpt-5.5

# The key for the provider WEB_AGENTS_MODEL names. Bundled providers: openai, deepseek.
OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=

# Encrypts visitors' API keys in the ai-settings cookie (32+ chars). Changing it signs everyone out of their key.
# Generate: openssl rand -base64 48
AI_SETTINGS_SECRET=
